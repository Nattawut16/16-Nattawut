import tkinter as tk
from tkinter import messagebox
from datetime import datetime, timedelta, time

# ------------------ Logic ------------------
def get_thai_time():
    return datetime.utcnow() + timedelta(hours=7)

def calculate():
    try:
        name1 = entry_name1.get()
        hour1 = float(entry_hour1.get())

        name2 = entry_name2.get()
        hour2 = float(entry_hour2.get())

        wake_str = entry_wake.get().replace('.', ':')
        if ':' not in wake_str:
            wake_str += ":00"

        h, m = map(int, wake_str.split(':'))
        if not (0 <= h < 24 and 0 <= m < 60):
            raise ValueError

        sleep_hour = float(entry_sleep.get())

        if hour1 < 0 or hour2 < 0 or sleep_hour < 0:
            raise ValueError

        wake_up_time = time(h, m)
        dummy_date = datetime(2000, 1, 2, h, m)
        bedtime_dt = dummy_date - timedelta(hours=sleep_hour)

        total_hours = hour1 + hour2
        day_note = " (เมื่อคืน)" if bedtime_dt.day < dummy_date.day else ""

        result = (
            f"📅 ตารางสรุปกิจกรรม (เวลาไทย)\n"
            f"• {name1} : {hour1} ชม.\n"
            f"• {name2} : {hour2} ชม.\n"
            f"• รวมกิจกรรม : {total_hours} ชม.\n"
            f"------------------------\n"
            f"⏰ ตื่นเวลา : {wake_up_time.strftime('%H:%M')} น.\n"
            f"🛌 ควรเข้านอน : {bedtime_dt.strftime('%H:%M')} น.{day_note}"
        )

        text_result.config(state="normal")
        text_result.delete(1.0, tk.END)
        text_result.insert(tk.END, result)
        text_result.config(state="disabled")

    except:
        messagebox.showerror("ข้อผิดพลาด", "กรุณากรอกข้อมูลให้ถูกต้อง")

# ------------------ GUI ------------------
root = tk.Tk()
root.title("ตารางเวลาเข้านอน (Thai Time)")
root.geometry("420x520")

now_label = tk.Label(
    root,
    text=f"🇹🇭 เวลาไทยปัจจุบัน: {get_thai_time().strftime('%H:%M')} น.",
    font=("Tahoma", 11)
)
now_label.pack(pady=10)

frame = tk.Frame(root)
frame.pack(pady=5)

def add_row(text):
    tk.Label(frame, text=text, anchor="w").pack(fill="x")

add_row("กิจกรรมที่ 1")
entry_name1 = tk.Entry(frame)
entry_name1.pack(fill="x")
entry_hour1 = tk.Entry(frame)
entry_hour1.pack(fill="x")

add_row("กิจกรรมที่ 2")
entry_name2 = tk.Entry(frame)
entry_name2.pack(fill="x")
entry_hour2 = tk.Entry(frame)
entry_hour2.pack(fill="x")

add_row("⏰ เวลาตื่น (เช่น 06:30)")
entry_wake = tk.Entry(frame)
entry_wake.pack(fill="x")

add_row("😴 ชั่วโมงการนอน")
entry_sleep = tk.Entry(frame)
entry_sleep.pack(fill="x")

tk.Button(
    root,
    text="คำนวณเวลาเข้านอน",
    command=calculate,
    bg="#4CAF50",
    fg="white",
    font=("Tahoma", 11)
).pack(pady=10)

text_result = tk.Text(root, height=10, state="disabled")
text_result.pack(padx=10, pady=10, fill="both")

root.mainloop()
